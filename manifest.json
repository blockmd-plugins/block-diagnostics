{
  "app": "blockmd",
  "schema_version": 1,
  "id": "block-diagnostics",
  "name": {
    "zh": "性能与占用",
    "en": "Performance & Usage"
  },
  "version": "1.2.0",
  "beta": true,
  "author": "Block Community",
